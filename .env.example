# Öffentliche Adresse der App, ohne Schrägstrich am Ende
APP_URL=http://localhost:3000

# Mindestens 32 zufällige Zeichen, z. B. mit: openssl rand -base64 32
SESSION_SECRET=

# Microsoft Entra ID (App-Registrierung „CRM SCREEN-BOX“)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Kommagetrennte Liste der Konten, die sich anmelden dürfen
ALLOWED_EMAILS=office@screen-box.de

# MySQL-Datenbank (auf Hostinger: 127.0.0.1, Name und Benutzer mit Präfix u854230355_)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Lexware Office Public API (app.lexware.de/addons/public-api)
LEXWARE_API_KEY=

# Postfächer, deren Mails eingelesen werden (kommagetrennt). hello@ ist ein Alias von office@.
MAIL_MAILBOXES=office@screen-box.de

# Ordner, die übersprungen werden (Papierkorb, Junk, Entwürfe sind immer ausgenommen)
MAIL_SKIP_FOLDERS=BELEGE to LEXOFFICE,gebucht lexoffice,gekauft

# Weitere eigene Domains; Mails von und an diese Adressen werden übergangen
MAIL_OWN_DOMAINS=

# Schlüssel für den Cronjob-Aufruf von /api/cron/mail
CRON_SECRET=

# Adresssuche (Google Places API (New), nur serverseitig). Ohne Schlüssel gibt es nur Vorschläge aus eigenen Daten.
GOOGLE_PLACES_KEY=
# eigene Grenzen des CRM, zusätzlich zu den Tageskontingenten in Google Cloud
PLACES_DAILY_LIMIT=250
PLACES_WEBSITE_MONTHLY_LIMIT=300
